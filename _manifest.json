{
  "manifest_version": 2,
  "id": "hohoko-chan.phone-play",
  "plugin_type": "game",
  "version": "0.3.1",
  "name": "刷会儿手机",
  "description": "让 Bot 用安卓手机、模拟器或 iPhone 自己刷视频、逛帖子、听歌、看小说，按人设和兴趣挑内容；支持 WebUI 实时观看和 /手机截图 命令。",
  "author": {
    "name": "hatsuhoq",
    "url": "https://github.com/hatsuhoq"
  },
  "license": "GPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/hatsuhoq/maibot-phone-play"
  },
  "display": {
    "icon": {
      "type": "local",
      "value": "icon.png",
      "fallback": "smartphone"
    }
  },
  "host_application": {
    "min_version": "1.4.0",
    "max_version": "1.4.99"
  },
  "sdk": {
    "min_version": "2.21.0",
    "max_version": "2.22.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.27"
    },
    {
      "type": "python_package",
      "name": "pillow",
      "version_spec": ">=10.1"
    }
  ],
  "capabilities": [
    "api.call",
    "config.get",
    "desktop_pet.list_animations",
    "desktop_pet.play_event",
    "desktop_pet.refresh_buttons",
    "desktop_pet.say",
    "desktop_pet.status",
    "llm.generate",
    "maisaka.proactive.trigger",
    "render.html2png",
    "send.image",
    "send.text"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "changelog": "changelog.md"
}
